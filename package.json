{
  "name": "agentes-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Demo local de una plataforma de agentes con dial de autonomía, reglas, aprobaciones y trazas.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "demo": "npm run build && npm start",
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "dev:console": "vite --config console/vite.config.ts",
    "build": "vite build --config console/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.5",
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@octokit/rest": "^22.0.1",
    "fastify": "^5.12.4",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
