# Proveedor de IA: mock | anthropic | bedrock
# Si no se define: "anthropic" cuando hay ANTHROPIC_API_KEY, y "mock" en otro caso.
# LLM_PROVIDER=mock

# Claude API directa
ANTHROPIC_API_KEY=

# Claude en Amazon Bedrock (usa la cadena de credenciales estándar de AWS)
AWS_REGION=eu-west-1
AWS_PROFILE=

# Latencia simulada del modo mock, en milisegundos por turno
MOCK_LATENCY_MS=700

PORT=4000

# GitHub (opcional): el agente de código abre PRs reales en un repositorio VACÍO dedicado a la demo.
# Token fine-grained solo para ese repositorio. Ver "Conectar GitHub" en README.md.
GITHUB_TOKEN=
# owner/nombre
GITHUB_REPO=
# Rama base (por defecto main)
GITHUB_BASE_BRANCH=
# off fuerza el modo local aunque haya token
DEMO_GITHUB=

# Avisos de caducidad (avisos-de-caducidad)
# ERP tiendas: API REST del ERP de tiendas.
AVISOS_DE_CADUCIDAD_ERP_TIENDAS_URL=
AVISOS_DE_CADUCIDAD_ERP_TIENDAS_TOKEN=
# Avisos tienda: Canal de avisos de las tiendas.
AVISOS_DE_CADUCIDAD_AVISOS_TIENDA_WEBHOOK_URL=
