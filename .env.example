# Proveedor de IA: mock | anthropic | bedrock
# Si no se define: "anthropic" cuando hay ANTHROPIC_API_KEY, y "mock" en otro caso.
# LLM_PROVIDER=mock

# Claude API directa
ANTHROPIC_API_KEY=

# Claude en Amazon Bedrock (usa la cadena de credenciales estándar de AWS)
AWS_REGION=eu-west-1
AWS_PROFILE=

# Latencia simulada del modo mock, en milisegundos por turno
MOCK_LATENCY_MS=700

PORT=4000

# GitHub (opcional): los agentes de código y creador abren PRs reales contra este mismo repositorio
# (el origin del clon). Nunca fusionan: los fusiona una persona en GitHub y la plataforma lo detecta.
# Token fine-grained solo para este repositorio (Contents y Pull requests: lectura y escritura).
GITHUB_TOKEN=
# owner/nombre; por defecto, el origin de este repositorio
GITHUB_REPO=
# Rama base (por defecto main)
GITHUB_BASE_BRANCH=
# off fuerza el modo local aunque haya token
DEMO_GITHUB=
